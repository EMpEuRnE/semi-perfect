# Copy to .env.local only when connecting your Supabase project.
# Public browser-safe credentials only. Never use sb_secret_* or service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
